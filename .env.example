# --- LLM provider ---
# groq | nvidia | openai | local
LLM_PROVIDER=groq
# Model string (groq model if provider is groq)
LLM_MODEL=llama-3.3-70b-versatile
# Groq: free key from https://console.groq.com/keys (fastest)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# NVIDIA NIM: free key from https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
OPENAI_API_KEY=
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:14b
LLM_TEMPERATURE=0.85
# Providers tried in order; next is used if a call times out (fallback)
LLM_PROVIDER_PRIORITY=groq,nvidia

# --- Storage / queue ---
# Empty DATABASE_URL -> SQLite (works without docker)
DATABASE_URL=
# Empty REDIS_URL -> synchronous background-thread mode (no celery). Set for docker/async:
REDIS_URL=

# --- Detector ---
# mock | colab
DETECTOR_MODE=mock
DETECTOR_RESULTS_PATH=detector_results.json

# --- Pipeline tuning (fast defaults) ---
HUMANIZE_THRESHOLD=0.6
# max eval/humanize rounds (draft counts as round 0)
MAX_ITERATIONS=2
# always run at least this many humanize rewrites, even if the draft already passes
MIN_HUMANIZE_PASSES=1
MAX_TOKENS=4096

# --- Timeouts / observability ---
# Seconds to wait on a single LLM call before failing over / aborting (was 900)
LLM_TIMEOUT_SECONDS=30
# OpenAI SDK retries per call (each adds one full timeout period)
LLM_MAX_RETRIES=0
# Mark queued/generating jobs older than this as failed (startup sweep)
JOB_STALE_SECONDS=900
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# log file (console + rotating file handler)
LOG_FILE=logs/app.log