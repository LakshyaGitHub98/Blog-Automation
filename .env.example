# --- LLM provider ---
# nvidia | openai | local
LLM_PROVIDER=nvidia
# Model string lives in env because NVIDIA model names change often
LLM_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_API_KEY=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
OPENAI_API_KEY=
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:14b
LLM_TEMPERATURE=0.85

# --- Storage / queue ---
# Empty DATABASE_URL -> SQLite (works without docker)
DATABASE_URL=
# Empty REDIS_URL -> synchronous mode (no celery). Set for docker/async:
REDIS_URL=

# --- Detector ---
# mock | colab
DETECTOR_MODE=mock
DETECTOR_RESULTS_PATH=detector_results.json

# --- Pipeline tuning ---
HUMANIZE_THRESHOLD=0.6
MAX_ITERATIONS=3
